#include <windows.h>
#include "gui_resource.h"
#include "version.h"

IDI_APP ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "gui.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     BRIDGE_VERSION_MAJOR, BRIDGE_VERSION_MINOR, BRIDGE_VERSION_PATCH, 0
PRODUCTVERSION  BRIDGE_VERSION_MAJOR, BRIDGE_VERSION_MINOR, BRIDGE_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Phone Link Headset Bridge"
            VALUE "ProductName",      "Phone Link Headset Bridge"
            VALUE "FileVersion",      BRIDGE_VERSION
            VALUE "ProductVersion",   BRIDGE_VERSION
            VALUE "OriginalFilename", "headset_bridge_gui.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
